{
  "name": "nz-visa-auto-push",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "config",
    "README.md",
    "package.json",
    "pnpm-lock.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "run": "tsx src/index.ts run",
    "check": "tsc --noEmit",
    "start:compiled": "node dist/index.js run",
    "discover:compiled": "node dist/index.js discover",
    "license:init": "node tools/license-init.mjs",
    "license:issue": "node tools/license-issue.mjs",
    "package:licensed": "node tools/package-portable.mjs --licensed",
    "package:portable": "node tools/package-portable.mjs",
    "package:portable:zip": "node tools/package-portable.mjs",
    "package:standalone": "node tools/package-standalone.mjs --licensed --target=win64",
    "package:standalone:all": "node tools/package-standalone.mjs --licensed --target=all",
    "package:standalone:mac-arm64": "node tools/package-standalone.mjs --licensed --target=mac-arm64",
    "package:standalone:mac-x64": "node tools/package-standalone.mjs --licensed --target=mac-x64",
    "package:standalone:template": "node tools/package-standalone.mjs --licensed=false --target=win64"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "playwright": "^1.52.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "javascript-obfuscator": "^5.4.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
